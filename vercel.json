{
  "version": 2,
  "buildCommand": "cd network-ui && npm install && npm run build",
  "builds": [
    {
      "src": "server.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dataset.txt"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server.cjs" }
  ]
}
